{
  "name": "tamanna-portal",
  "version": "0.13.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:norms": "tsx scripts/check-norms.ts",
    "check:omr": "tsx scripts/check-omr.ts",
    "check:report": "tsx --tsconfig tsconfig.json scripts/smoke-report.tsx",
    "check:import": "tsx scripts/check-import.ts",
    "check:school": "tsx scripts/check-school.ts",
    "setup:database": "tsx scripts/setup-database.ts --apply",
    "setup:admin": "tsx scripts/setup-admin.ts",
    "copies": "tsx scripts/copy-batch.ts",
    "copies:key": "tsx scripts/prepare-key.ts",
    "predev": "node scripts/setup.js",
    "setup": "node scripts/setup.js",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run check:norms && npm run check:omr && npm run check:report && npm run check:import && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.0",
