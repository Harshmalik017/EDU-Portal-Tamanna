    "next": "16.4.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.1.10",
    "react-dom": "^19.1.10"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.16"
  }
