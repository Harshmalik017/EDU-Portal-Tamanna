{
  "name": "tamanna-portal",
  "version": "0.9.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:norms": "tsx scripts/check-norms.ts",
    "check:report": "tsx --tsconfig tsconfig.json scripts/smoke-report.tsx",
    "predev": "node scripts/setup.js",
    "setup": "node scripts/setup.js",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm run check:norms && npm run check:report && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.451.0",
    "next": "16.4.2",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "@supabase/ssr": "^0.5.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.5.4",
    "tsx": "^4.19.0",
    "tailwindcss": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
